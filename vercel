 *
 * The helpers of this runite. Every command runs in this terminal,
 * so the questions of the Vercel CLI (login, link) are answered here.
 */
const VERCEL_TARGET = 'production';          // the environment of env:* when --target is left out
const VERCEL_CODE = 'src/vercel.php';        // the integration file made by 'php vercel code'

// a spell with a value, or its default (a spell without a value is '1')
function vercel_spell( String $key, String $default = '' ) {
  $value = Chanter::spell($key);
  return ($value === false || $value === '' || $value === '1') ? $default : trim((string) $value);
}

// one line of output: ok, warn, fail or info
function vercel_line( String $state, String $text ) {
  $color = ['ok'=> 'success', 'warn'=> 'warning', 'fail'=> 'danger', 'info'=> 'secondary'][$state];
  $icon = ['ok'=> 'success', 'warn'=> 'warning', 'fail'=> 'danger', 'info'=> 'info'][$state];
  Whisper::echo("{{color-$color}}{{icon-$icon}}{{color-end}} $text{{nl}}");
}

// the Vercel CLI: local (node_modules/.bin) first, then global; false when missing
function vercel_bin() {
  $local = __DIR__ . '/node_modules/.bin/vercel' . (PHP_OS_FAMILY === 'Windows' ? '.cmd' : '');
  if (is_file($local)) {
    return ['local', escapeshellarg($local)];
  }
  exec('vercel --version 2>&1', $out, $code);
  return $code === 0 ? ['global', 'vercel'] : false;
}

// the CLI or a hint to run init
function vercel_need() {
  $bin = vercel_bin();
  if (!$bin) vercel_line('fail', 'Vercel CLI not found, run: php vercel init');
  return $bin ? $bin[1] : false;
}

// run in this terminal (questions are answered here); $input is sent to stdin
function vercel_run( String $args, ?String $input = null ) {
  $bin = vercel_need();
  if (!$bin) return 1;
  if ($input === null) {
    passthru("$bin $args", $code);
    return $code;
  }
  $process = proc_open("$bin $args", [0=> ['pipe', 'r'], 1=> STDOUT, 2=> STDERR], $pipes);
  if (!is_resource($process)) return 1;
  fwrite($pipes[0], $input);
  fclose($pipes[0]);
  return proc_close($process);
}

// run quietly and read the answer
function vercel_read( String $args ) {
  $bin = vercel_need();
  return $bin ? (string) shell_exec("$bin $args 2>&1") : '';
}

// run beside the flow and keep the flash moving until it ends: [exit code, output]
// (a blocking call would freeze the bar; the output goes to a file, pipes can block on Windows)
function vercel_wait( String $command, Callable $animation ) {
  $file = tempnam(sys_get_temp_dir(), 'vercel');
  $process = proc_open("$command > " . escapeshellarg($file) . ' 2>&1', [], $pipes);
  if (!is_resource($process)) return [1, ''];
  do {
    $animation();
    usleep(60000);
    $status = proc_get_status($process);
  } while ($status['running']);
  proc_close($process);
  $output = (string) file_get_contents($file);
  unlink($file);
  return [$status['exitcode'], $output];
}

// is this folder linked to a Vercel project?
function vercel_project() {
  $file = __DIR__ . '/.vercel/project.json';
  // file_get_contents, not Forger: Forger would keep it as a shard of the relic
  return is_file($file) ? json_decode((string) file_get_contents($file)) : null;
}

// the target environment: production, preview or development
function vercel_target() {
  $target = vercel_spell('target', VERCEL_TARGET);
  if (!in_array($target, ['production', 'preview', 'development'])) {
    vercel_line('fail', "'$target' is not a target: --target=production|preview|development");
    return false;
  }
  return $target;
}

// the key of an environment variable, from --key or asked
function vercel_key() {
  $key = vercel_spell('key') ?: trim((string) Whisper::call('Key: '));
  if (!preg_match('/^[A-Za-z_][A-Za-z0-9_]*$/', $key)) {
    vercel_line('fail', "'$key' is not a key, e.g. --key=DATABASE_URL");
    return false;
  }
  return $key;
}

// does the key exist in the target? (reads 'vercel env list --environment <target> --json')
function vercel_env_has( String $key, String $target ) {
  $out = vercel_read("env list --environment $target --json");
  $json = json_decode(substr($out, (int) strpos($out, '{')), true);
  if (!is_array($json)) {
    return (bool) preg_match('/^\s*' . preg_quote($key, '/') . '\s/m', $out);
  }
  $found = false;
  array_walk_recursive($json, function($value, $field) use ($key, &$found) {
    if ($field === 'key' && $value === $key) $found = true;
  });
  return $found;
}

// the runite can only speak to a linked project
function vercel_linked() {
  if (vercel_project()) return true;
  vercel_line('fail', 'This folder is not linked to Vercel, run: php vercel link');
  return false;
}



