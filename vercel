/* V · ENV
 * list the environment variables, then manage them here
 * $ php vercel env --target=production
 * */
Chanter::cast(
  arg: 'env --target',
  echo: 'List and manage environment variables.',
  execute: function() {
    if (!vercel_linked()) return;
    $target = vercel_target();
    if (!$target) return;

    while (true) {
      vercel_run("env list --environment $target");
      $choice = strtolower(trim((string) Whisper::call('[a]dd · [s]et · [r]emove · [q]uit: ')));
      $cast = ['a'=> 'env:add', 's'=> 'env:set', 'r'=> 'env:remove'][$choice] ?? null;
      if (!$cast) return;
      Chanter::cast("$cast --target=$target")();
    }
  }
);


/* VI · ENV:ADD
 * add a new variable; skipped when the key exists
 * $ php vercel env:add --key=DATABASE_URL --value=postgres://... --target=production
 * [i]INFO: --value is asked when it is left out
 * */
Chanter::cast(
  arg: 'env:add --key --value --target',
  echo: 'Add a new environment variable.',
  execute: function() {
    // read every spell first
    $value = vercel_spell('value');
    $target = vercel_target();
    $key = vercel_key();
    if (!$target || !$key || !vercel_linked()) return;

    if (vercel_env_has($key, $target)) {
      vercel_line('info', "$key already exists in $target, change it with: php vercel env:set --key=$key");
      return;
    }
    $value = $value ?: (string) Whisper::call("Value of $key: ");
    $code = vercel_run('env add ' . escapeshellarg($key) . " --environment $target", $value);
    vercel_line($code === 0 ? 'ok' : 'fail', $code === 0 ? "$key added to $target" : "$key not added");
  }
);


/* VII · ENV:SET
 * make or change a variable
 * $ php vercel env:set --key=DATABASE_URL --value=postgres://... --target=production
 * */
Chanter::cast(
  arg: 'env:set --key --value --target',
  echo: 'Make or change an environment variable.',
  execute: function() {
    // read every spell first
    $value = vercel_spell('value');
    $target = vercel_target();
    $key = vercel_key();
    if (!$target || !$key || !vercel_linked()) return;

    $value = $value ?: (string) Whisper::call("Value of $key: ");

    // --force: make it, or overwrite the value it has in this target
    $code = vercel_run('env add ' . escapeshellarg($key) . " --environment $target --force", $value);
    vercel_line($code === 0 ? 'ok' : 'fail', $code === 0 ? "$key set in $target" : "$key not set");
  }
);


/* VIII · ENV:REMOVE
 * remove a variable; skipped when the key is not found
 * $ php vercel env:remove --key=DATABASE_URL --target=production
 * */
Chanter::cast(
  arg: 'env:remove --key --target',
  echo: 'Remove an environment variable.',
  execute: function() {
    // read every spell first
    $target = vercel_target();
    $key = vercel_key();
    if (!$target || !$key || !vercel_linked()) return;

    if (!vercel_env_has($key, $target)) {
      vercel_line('info', "$key not found in $target");
      return;
    }
    vercel_read('env remove ' . escapeshellarg($key) . " --environment $target --yes");
    vercel_line(vercel_env_has($key, $target) ? 'fail' : 'ok', "$key removed from $target");
  }
);


