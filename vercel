Chanter::cast(
  arg: 'init',
  echo: 'Check or install the Vercel CLI.',
  execute: function() {
    $bin = vercel_bin();
    if ($bin) {
      $version = trim(vercel_read('--version'));
      vercel_line('ok', "Vercel CLI ($bin[0]) " . (preg_match('/[\d.]+/', $version, $m) ? $m[0] : $version));
      return;
    }

    exec('npm --version 2>&1', $out, $code);
    if ($code !== 0) {
      vercel_line('fail', 'npm not found, install Node.js first: https://nodejs.org');
      return;
    }

    vercel_line('info', 'Vercel CLI not found, installing: npm install -g vercel');
    passthru('npm install -g vercel', $code);
    vercel_line($code === 0 && vercel_bin() ? 'ok' : 'fail', $code === 0 ? 'Vercel CLI installed' : 'Install failed, try: npm install -g vercel');
  }
);


/* II · CODE
 * write src/vercel.php once: Vercel::env(), Vercel::is(), Vercel::target(), ...
 * $ php vercel code
 * [i]INFO: php cast build bundles it into api/index.php, before src/index.php
 * */
Chanter::cast(
  arg: 'code',
  echo: 'Make src/vercel.php for the API.',
  execute: function() {
    $file = __DIR__ . '/' . VERCEL_CODE;
    if (is_file($file)) {
      vercel_line('info', VERCEL_CODE . ' already exists');
      return;
    }

    $code = <<<'PHP'
<?php

/* VERCEL
 * the API on Vercel: environment variables and where it runs
 * made by 'php vercel code', bundled into api/index.php by 'php cast build'
 * */
class Vercel {

  // an environment variable (php vercel env:set), or its default
  public static function env( String $key, $default = null ) {
    $value = getenv($key);
    return $value === false ? $default : $value;
  }

  // true when this request runs on Vercel
  public static function is() {
    return getenv('VERCEL') === '1';
  }

  // production, preview or development
  public static function target() {
    return getenv('VERCEL_ENV') ?: 'development';
  }

  // the url of this deployment, e.g. https://my-app-abc123.vercel.app
  public static function url() {
    $url = getenv('VERCEL_URL');
    return $url ? "https://$url" : null;
  }

  // the region of this function, e.g. iad1
  public static function region() {
    return getenv('VERCEL_REGION') ?: null;
  }

}

PHP;
    Forger::fix(Forger::trace($file));
    Forger::item($file, str_replace("\n", PHP_EOL, $code));
    vercel_line('ok', VERCEL_CODE . ' made, rebuild to bundle it: php cast build');
  }
);


